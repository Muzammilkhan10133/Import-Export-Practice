rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Shipments
    match /shipments/{shipmentId} {
      allow read: if true;
      allow write: if true;
    }

    // Tracking events
    match /tracking_events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    // Customs declarations
    match /customs/{customsId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
